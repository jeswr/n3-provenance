{
  "name": "@jeswr/n3-provenance",
  "version": "0.1.0",
  "description": "Lexical quad provenance built on N3.js token callbacks.",
  "type": "module",
  "main": "./src/index.js",
  "exports": "./src/index.js",
  "sideEffects": false,
  "files": ["src", "README.md", "LICENSE.md"],
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeswr/n3-provenance.git"
  },
  "bugs": {
    "url": "https://github.com/jeswr/n3-provenance/issues"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint src test examples",
    "demo": "node examples/demo.js"
  },
  "dependencies": {
    "n3": "git+https://github.com/jeswr/N3.js.git#a89bd277df10efd45dc1ea3b113b82c74dcafc45"
  },
  "devDependencies": {
    "@rdfjs/data-model": "1.3.4",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "rdf-isomorphic": "2.0.1"
  },
  "jest": {
    "testMatch": ["**/test/*-test.js"],
    "transform": {},
    "collectCoverage": true,
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageProvider": "v8",
    "coverageReporters": ["text", "lcov"],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
