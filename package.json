{
  "name": "n3-provenance",
  "version": "0.1.0",
  "description": "Lexical quad provenance built on N3.js token callbacks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "license": "MIT",
  "author": "Jesse Wright",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeswr/n3-provenance.git"
  },
  "bugs": {
    "url": "https://github.com/jeswr/n3-provenance/issues"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "lint": "tsc -p . --noEmit && tsc -p test/types && eslint .",
    "demo": "node examples/demo.js"
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "n3": "^2.13.4"
  },
  "devDependencies": {
    "@rdfjs/data-model": "2.1.2",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "rdf-isomorphic": "2.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "jest": {
    "testMatch": [
      "**/test/*-test.js"
    ],
    "transform": {
      "\\.ts$": "<rootDir>/test/transform-typescript.cjs"
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/n3-internals.ts"
    ],
    "coverageProvider": "v8",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}
